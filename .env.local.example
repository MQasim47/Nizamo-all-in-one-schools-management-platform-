# Copy to .env.local and fill in. Never commit .env.local.
# Restart `npm run dev` after any change.

# --- Supabase ---------------------------------------------------------------

# Project URL (Project Settings > API). Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable/anon key. Public by design; used with a signed per-user token, so RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Secret/service_role key. SERVER-ONLY, bypasses RLS: used only in lib/db/admin/* and scripts/.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Legacy JWT secret (Project Settings > API > JWT Settings). SERVER-ONLY. The app signs the short-lived
# per-user token with it (lib/supabase/school.js); Postgres RLS trusts that token.
SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# --- NextAuth ---------------------------------------------------------------

# Signs/verifies the session cookie (lib/auth/options.js, middleware.js). Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Read by NextAuth itself. Optional on localhost and Vercel; required in production elsewhere.
NEXTAUTH_URL=http://localhost:3000

# --- Multi-tenant routing ---------------------------------------------------

# Root domain schools hang off (ghs.nizamo.com -> school "ghs"). Leave empty in local dev.
# middleware.js only reads a subdomain from the host when this is set.
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Demo mode (development only) ------------------------------------------

# "true" shows demo shortcuts on the login page of the demo school. Must be false/unset in production.
NEXT_PUBLIC_DEMO_MODE=false

# Server-only demo passwords. Generated by `npm run demo:passwords`; never reused across accounts.
# DEMO_PASSWORD_SUPERADMIN is never shown when NODE_ENV=production.
DEMO_PASSWORD_PRINCIPAL=
DEMO_PASSWORD_TEACHER=
DEMO_PASSWORD_SUPERADMIN=
