# Copy to .env.local and fill in. Never commit .env.local.
# Restart `npm run dev` after any change.

# Supabase project URL (Project Settings > API). Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key. Public by design; only safe because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key. SERVER-ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs/verifies the NextAuth JWT; read by lib/auth.js and middleware.js. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Not read by app code, but NextAuth v4 reads it itself. Optional on localhost and on Vercel;
# required in production on any other host. Set to the canonical site URL.
NEXTAUTH_URL=http://localhost:3000
